{
  "name": "hydrogen-tailwind-asriui",
  "description": "Starter Shopify Hydrogen storefront (React Router) with Tailwind CSS, AsriUI components, Vitest, Playwright, and CI—run locally with a mock shop or link your store.",
  "keywords": [
    "shopify",
    "hydrogen",
    "headless-commerce",
    "react",
    "react-router",
    "storefront",
    "tailwindcss",
    "asriui",
    "vitest",
    "playwright",
    "ecommerce",
    "oxygen"
  ],
  "private": true,
  "sideEffects": false,
  "version": "2026.4.8",
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen",
    "preview": "shopify hydrogen preview --build",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "codegen": "shopify hydrogen codegen && react-router typegen"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@shopify/hydrogen": "2026.4.7",
    "@tailwindcss/vite": "^4.3.3",
    "asriui": "^0.1.1",
    "framer-motion": "^14.4.0",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.16.0",
    "react-router-dom": "7.16.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "5.0.2",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "7.16.0",
    "@react-router/fs-routes": "7.16.0",
    "@shopify/cli": "3.93.2",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "graphql-config": "^5.0.3",
    "happy-dom": "^21.0.3",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "vite": "^8.0.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22 || ^24"
  }
}
